#!/bin/sh
# Launcher for neo4j-cert-tool on Linux and macOS.
#
# Finds a JDK 25 or later and runs the packaged jar. Any arguments are passed straight through.

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
jar="$script_dir/../target/neo4j-cert-tool.jar"

if [ ! -f "$jar" ]; then
    echo "neo4j-cert-tool.jar not found at $jar" >&2
    echo "Build it first:  mvn package" >&2
    exit 1
fi

if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    java_command="$JAVA_HOME/bin/java"
elif command -v java >/dev/null 2>&1; then
    java_command=java
else
    echo "No Java runtime found. Install JDK 25 or later, or set JAVA_HOME." >&2
    exit 1
fi

# The tool is compiled for release 25, so an older runtime would fail with an
# UnsupportedClassVersionError that says nothing useful about what to do next.
version=$("$java_command" -XshowSettings:properties -version 2>&1 \
    | sed -n 's/^ *java\.specification\.version *= *\([0-9][0-9]*\).*/\1/p' \
    | head -1)
if [ -n "$version" ] && [ "$version" -lt 25 ]; then
    echo "neo4j-cert-tool needs JDK 25 or later, but $java_command is Java $version." >&2
    exit 1
fi

exec "$java_command" -jar "$jar" "$@"
